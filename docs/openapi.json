{
  "openapi": "3.1.0",
  "info": {
    "title": "TwitchDropsNAS API",
    "version": "1.0.1",
    "description": "Single-account NAS Drops management; manual claiming only."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ],
  "paths": {
    "/snapshot": {
      "get": {
        "summary": "Read private state",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        }
      }
    },
    "/auth/start": {
      "post": {
        "summary": "Begin human device approval",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clientId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/cancel": {
      "post": {
        "summary": "Cancel approval",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        }
      }
    },
    "/auth/disconnect": {
      "post": {
        "summary": "Disconnect Twitch",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        }
      }
    },
    "/control": {
      "post": {
        "summary": "Start/pause queue",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "running"
                ],
                "properties": {
                  "running": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/settings": {
      "patch": {
        "summary": "Connection settings",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "networkMode"
                ],
                "properties": {
                  "networkMode": {
                    "enum": [
                      "auto",
                      "direct",
                      "proxy"
                    ]
                  },
                  "checkMinSeconds": {
                    "type": "integer",
                    "minimum": 120,
                    "maximum": 10800
                  },
                  "checkMaxSeconds": {
                    "type": "integer",
                    "minimum": 120,
                    "maximum": 10800
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "post": {
        "summary": "Create task",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Task"
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "put": {
        "summary": "Update task",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Task"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete task",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/sync": {
      "post": {
        "summary": "Force asynchronous official refresh",
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        }
      }
    },
    "/automation": {
      "get": {
        "summary": "Scheduler state",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        }
      },
      "patch": {
        "summary": "Control internal scheduler",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/session": {
      "get": {
        "summary": "Current UI session",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        }
      },
      "post": {
        "summary": "Authenticate browser",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 24
                  }
                }
              }
            }
          }
        },
        "security": []
      },
      "delete": {
        "summary": "Log out browser",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "API contract",
        "responses": {
          "200": {
            "description": "Success"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State or capability unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tdm_session"
      }
    },
    "schemas": {
      "RewardRef": {
        "type": "object",
        "required": [
          "campaignId",
          "dropId"
        ],
        "additionalProperties": false,
        "properties": {
          "campaignId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dropId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "Goal": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "all",
              "selected"
            ]
          },
          "reset": {
            "type": "boolean",
            "default": false
          },
          "rewards": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/RewardRef"
            }
          }
        }
      },
      "Task": {
        "type": "object",
        "required": [
          "gameName",
          "priority",
          "enabled",
          "watchOnly",
          "autoChannels",
          "channels"
        ],
        "properties": {
          "gameName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "channels": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,25}$"
            }
          },
          "goal": {
            "$ref": "#/components/schemas/Goal"
          },
          "enabled": {
            "type": "boolean"
          },
          "watchOnly": {
            "type": "boolean"
          },
          "autoChannels": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
